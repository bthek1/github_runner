 your Proxmox details to populate terraform.tfvars# terraform.tfvars.example
# Copy to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit real credentials.

proxmox_endpoint = "https://192.168.1.100:8006/"
proxmox_username = "root@pam"
# proxmox_password = "changeme"   # or use PROXMOX_VE_PASSWORD env var
# proxmox_api_token = ""          # alternative to username/password

proxmox_node = "pve"

container_id       = 100
container_hostname = "terraCT"
container_tags     = ["terraform", "lxc"]

# Ubuntu 24.04 LXC template — download via Proxmox UI or pveam first
template_file_id = "local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst"
os_type          = "ubuntu"

cpu_cores    = 1
memory_mb    = 512
swap_mb      = 512
disk_size    = 8
datastore_id = "local-lvm"

network_bridge = "vmbr0"
network_ip     = "dhcp"
# network_ip     = "192.168.1.101/24"   # static example
# network_gateway = "192.168.1.1"

# ssh_public_keys = "ssh-ed25519 AAAA..."
start_on_create = true
start_on_boot   = false
unprivileged    = true
nesting         = true

# ── GitHub Runner ─────────────────────────────────────────────────────────────

# List of GitHub org or repo URLs to register the runner with.
# Use org URL (https://github.com/org) for access to all repos in that org.
github_runner_targets = [
  "https://github.com/<org1>",
  # "https://github.com/<org2>",
]

# Tokens are injected via TF_VAR_github_runner_tokens — never store here.
# Generate one token per target in the same order, comma-separated:
# export TF_VAR_github_runner_tokens="$(
#   gh api --method POST -H 'Accept: application/vnd.github+json' \
#     /orgs/<org1>/actions/runners/registration-token --jq '.token'
# ),$(gh api --method POST -H 'Accept: application/vnd.github+json' \
#     /orgs/<org2>/actions/runners/registration-token --jq '.token')"

github_runner_name    = "proxmox-lxc-runner"
github_runner_labels  = ["self-hosted", "linux", "proxmox"]
github_runner_user    = "runner"
github_runner_version = "2.316.1"
